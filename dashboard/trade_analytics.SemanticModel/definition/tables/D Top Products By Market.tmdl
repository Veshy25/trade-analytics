table 'D Top Products By Market'
	lineageTag: d-tpbm

	column sector
		dataType: string
		lineageTag: d-tpbm-sector
		summarizeBy: none
		sourceColumn: sector

	column partner_rank
		dataType: int64
		formatString: 0
		lineageTag: d-tpbm-pr
		summarizeBy: sum
		sourceColumn: partner_rank

		annotation SummarizationSetBy = Automatic

	column partner_desc
		dataType: string
		lineageTag: d-tpbm-partner
		summarizeBy: none
		sourceColumn: partner_desc

	column product_rank
		dataType: int64
		formatString: 0
		lineageTag: d-tpbm-pdr
		summarizeBy: sum
		sourceColumn: product_rank

		annotation SummarizationSetBy = Automatic

	column cmd_code
		dataType: string
		lineageTag: d-tpbm-cmd-code
		summarizeBy: none
		sourceColumn: cmd_code

	column cmd_desc
		dataType: string
		lineageTag: d-tpbm-cmd-desc
		summarizeBy: none
		sourceColumn: cmd_desc

	column value_2023_mn
		dataType: double
		formatString: #,##0.0
		lineageTag: d-tpbm-value
		summarizeBy: sum
		sourceColumn: value_2023_mn

	column pct_of_partner_sector
		dataType: double
		formatString: #,##0.0
		lineageTag: d-tpbm-pct
		summarizeBy: sum
		sourceColumn: pct_of_partner_sector

		annotation SummarizationSetBy = Automatic

	partition 'D Top Products By Market' = m
		mode: import
		source =
				let
					Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/Veshy25/trade-analytics/main/data/processed/track_d_top_products_by_market.csv"), [Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers,{{"sector", type text}, {"partner_rank", Int64.Type}, {"partner_desc", type text}, {"product_rank", Int64.Type}, {"cmd_code", type text}, {"cmd_desc", type text}, {"value_2023_mn", type number}, {"pct_of_partner_sector", type number}})
				in
					Typed

