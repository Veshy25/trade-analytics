table 'C Partner Totals'
	lineageTag: c-pt

	column partner_desc
		dataType: string
		lineageTag: c-pt-partner
		summarizeBy: none
		sourceColumn: partner_desc

	column rank_2023
		dataType: int64
		formatString: 0
		lineageTag: c-pt-rank
		summarizeBy: sum
		sourceColumn: rank_2023

		annotation SummarizationSetBy = Automatic

	column value_2023_bn
		dataType: double
		formatString: #,##0.0
		lineageTag: c-pt-v2023
		summarizeBy: sum
		sourceColumn: value_2023_bn

		annotation SummarizationSetBy = Automatic

	column pct_of_panel_2023
		dataType: double
		formatString: #,##0.0
		lineageTag: c-pt-pct
		summarizeBy: sum
		sourceColumn: pct_of_panel_2023

		annotation SummarizationSetBy = Automatic

	column value_2014_2023_bn
		dataType: double
		formatString: #,##0.0
		lineageTag: c-pt-vfull
		summarizeBy: sum
		sourceColumn: value_2014_2023_bn

		annotation SummarizationSetBy = Automatic

	partition 'C Partner Totals' = m
		mode: import
		source =
				let
					Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/Veshy25/trade-analytics/main/data/processed/track_c_partner_totals.csv"), [Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers,{{"partner_desc", type text}, {"rank_2023", Int64.Type}, {"value_2023_bn", type number}, {"pct_of_panel_2023", type number}, {"value_2014_2023_bn", type number}})
				in
					Typed

