table 'E Country Trade Balance'
	lineageTag: e-ctb

	column reporter_desc
		dataType: string
		lineageTag: e-ctb-reporter
		summarizeBy: none
		sourceColumn: reporter_desc

	column ref_year
		dataType: int64
		formatString: 0
		lineageTag: e-ctb-year
		summarizeBy: none
		sourceColumn: ref_year

		annotation SummarizationSetBy = Automatic

	column exports_bn
		dataType: double
		formatString: #,##0.0
		lineageTag: e-ctb-exp
		summarizeBy: sum
		sourceColumn: exports_bn

	column imports_bn
		dataType: double
		formatString: #,##0.0
		lineageTag: e-ctb-imp
		summarizeBy: sum
		sourceColumn: imports_bn

	column balance_bn
		dataType: double
		formatString: +#,##0.0;-#,##0.0
		lineageTag: e-ctb-bal
		summarizeBy: sum
		sourceColumn: balance_bn

	column balance_pct_of_trade
		dataType: double
		formatString: +#,##0.0;-#,##0.0
		lineageTag: e-ctb-bpct
		summarizeBy: sum
		sourceColumn: balance_pct_of_trade

		annotation SummarizationSetBy = Automatic

	column export_cover_pct
		dataType: double
		formatString: #,##0.0
		lineageTag: e-ctb-cov
		summarizeBy: sum
		sourceColumn: export_cover_pct

		annotation SummarizationSetBy = Automatic

	partition 'E Country Trade Balance' = m
		mode: import
		source =
				let
					Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/Veshy25/trade-analytics/main/data/processed/track_e_country_trade_balance.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers,{{"reporter_desc", type text}, {"ref_year", Int64.Type}, {"exports_bn", type number}, {"imports_bn", type number}, {"balance_bn", type number}, {"balance_pct_of_trade", type number}, {"export_cover_pct", type number}})
				in
					Typed

