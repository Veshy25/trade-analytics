table 'E India Chapter Balance 2023'
	lineageTag: e-icb

	column side
		dataType: string
		lineageTag: e-icb-side
		summarizeBy: none
		sourceColumn: side

	column rank_on_side
		dataType: int64
		formatString: 0
		lineageTag: e-icb-rank
		summarizeBy: sum
		sourceColumn: rank_on_side

		annotation SummarizationSetBy = Automatic

	column cmd_code
		dataType: string
		lineageTag: e-icb-cmd-code
		summarizeBy: none
		sourceColumn: cmd_code

	column cmd_desc
		dataType: string
		lineageTag: e-icb-cmd-desc
		summarizeBy: none
		sourceColumn: cmd_desc

	column exports_bn
		dataType: double
		formatString: #,##0.0
		lineageTag: e-icb-exp
		summarizeBy: sum
		sourceColumn: exports_bn

	column imports_bn
		dataType: double
		formatString: #,##0.0
		lineageTag: e-icb-imp
		summarizeBy: sum
		sourceColumn: imports_bn

	column balance_bn
		dataType: double
		formatString: +#,##0.0;-#,##0.0
		lineageTag: e-icb-bal
		summarizeBy: sum
		sourceColumn: balance_bn

	partition 'E India Chapter Balance 2023' = m
		mode: import
		source =
				let
					Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/Veshy25/trade-analytics/main/data/processed/track_e_india_chapter_balance_2023.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers,{{"side", type text}, {"rank_on_side", Int64.Type}, {"cmd_code", type text}, {"cmd_desc", type text}, {"exports_bn", type number}, {"imports_bn", type number}, {"balance_bn", type number}})
				in
					Typed

