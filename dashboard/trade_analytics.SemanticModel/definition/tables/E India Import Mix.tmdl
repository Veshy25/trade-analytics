table 'E India Import Mix'
	lineageTag: e-iim

	column rank_2023
		dataType: int64
		formatString: 0
		lineageTag: e-iim-rank
		summarizeBy: sum
		sourceColumn: rank_2023

		annotation SummarizationSetBy = Automatic

	column cmd_code
		dataType: string
		lineageTag: e-iim-cmd-code
		summarizeBy: none
		sourceColumn: cmd_code

	column cmd_desc
		dataType: string
		lineageTag: e-iim-cmd-desc
		summarizeBy: none
		sourceColumn: cmd_desc

	column imports_2023_bn
		dataType: double
		formatString: #,##0.0
		lineageTag: e-iim-imp
		summarizeBy: sum
		sourceColumn: imports_2023_bn

	column share_2014_pct
		dataType: double
		formatString: #,##0.0
		lineageTag: e-iim-s2014
		summarizeBy: sum
		sourceColumn: share_2014_pct

		annotation SummarizationSetBy = Automatic

	column share_2023_pct
		dataType: double
		formatString: #,##0.0
		lineageTag: e-iim-s2023
		summarizeBy: sum
		sourceColumn: share_2023_pct

		annotation SummarizationSetBy = Automatic

	column shift_ppt
		dataType: double
		formatString: +#,##0.0;-#,##0.0
		lineageTag: e-iim-shift
		summarizeBy: sum
		sourceColumn: shift_ppt

		annotation SummarizationSetBy = Automatic

	partition 'E India Import Mix' = m
		mode: import
		source =
				let
					Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/Veshy25/trade-analytics/main/data/processed/track_e_india_import_mix.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers,{{"rank_2023", Int64.Type}, {"cmd_code", type text}, {"cmd_desc", type text}, {"imports_2023_bn", type number}, {"share_2014_pct", type number}, {"share_2023_pct", type number}, {"shift_ppt", type number}})
				in
					Typed

