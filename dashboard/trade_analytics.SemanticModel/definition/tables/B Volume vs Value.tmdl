	partition 'B Volume vs Value' = m
		mode: import
		source =
				let
					Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/Veshy25/trade-analytics/main/data/processed/track_b_sector_volume_vs_value.csv"), [Delimiter=",", Columns=17, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers,{{"sector", type text}, {"value_2014_bn", type number}, {"value_2023_bn", type number}, {"mn_tonnes_2014", type number}, {"mn_tonnes_2023", type number}, {"usd_per_kg_2014", type number}, {"usd_per_kg_2023", type number}, {"value_cagr_pct", type number}, {"volume_cagr_pct", type number}, {"volume_change_pct", type number}, {"unit_value_change_pct", type number}, {"value_coverage_2014_pct", type number}, {"value_coverage_2023_pct", type number}, {"volume_flag", type text}, {"mn_tonnes_cov_adj_2014", type number}, {"mn_tonnes_cov_adj_2023", type number}, {"volume_change_cov_adj_pct", type number}})
				in
