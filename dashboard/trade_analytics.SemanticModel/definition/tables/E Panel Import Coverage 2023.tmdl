table 'E Panel Import Coverage 2023'
	lineageTag: e-pic

	column rank_by_imports
		dataType: int64
		formatString: 0
		lineageTag: e-pic-rank
		summarizeBy: sum
		sourceColumn: rank_by_imports

		annotation SummarizationSetBy = Automatic

	column cmd_code
		dataType: string
		lineageTag: e-pic-cmd-code
		summarizeBy: none
		sourceColumn: cmd_code

	column cmd_desc
		dataType: string
		lineageTag: e-pic-cmd-desc
		summarizeBy: none
		sourceColumn: cmd_desc

	column india_imports_2023_bn
		dataType: double
		formatString: #,##0.0
		lineageTag: e-pic-ind
		summarizeBy: sum
		sourceColumn: india_imports_2023_bn

	column panel_imports_2023_bn
		dataType: double
		formatString: #,##0.0
		lineageTag: e-pic-panel
		summarizeBy: sum
		sourceColumn: panel_imports_2023_bn

	column panel_coverage_pct
		dataType: double
		formatString: #,##0.0
		lineageTag: e-pic-cov
		summarizeBy: sum
		sourceColumn: panel_coverage_pct

		annotation SummarizationSetBy = Automatic

	partition 'E Panel Import Coverage 2023' = m
		mode: import
		source =
				let
					Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/Veshy25/trade-analytics/main/data/processed/track_e_panel_import_coverage_2023.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers,{{"rank_by_imports", Int64.Type}, {"cmd_code", type text}, {"cmd_desc", type text}, {"india_imports_2023_bn", type number}, {"panel_imports_2023_bn", type number}, {"panel_coverage_pct", type number}})
				in
					Typed

