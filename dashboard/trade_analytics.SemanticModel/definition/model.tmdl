model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["A CAGR","A Indexed Series","A Top10 Chapters","A India Chapter Contribution","B Sector Year Totals","B Sector Concentration 2023","B Volume vs Value","B Volume Coverage","C Partner Totals","C Partner Concentration","C Partner Rank Moves","D Sector Partner Matrix 2023","D Sector Partner Shift","D Sector Market Concentration","E Country Trade Balance","E India Chapter Balance 2023","E India Partner Balance"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'A CAGR'
ref table 'A Indexed Series'
ref table 'A Top10 Chapters'
ref table 'A India Chapter Contribution'
ref table 'B Sector Year Totals'
ref table 'B Sector Concentration 2023'
ref table 'B Volume vs Value'
ref table 'B Volume Coverage'
ref table 'C Partner Totals'
ref table 'C Partner Concentration'
ref table 'C Partner Rank Moves'
ref table 'D Sector Partner Matrix 2023'
ref table 'D Sector Partner Shift'
ref table 'D Sector Market Concentration'
ref table 'E Country Trade Balance'
ref table 'E India Chapter Balance 2023'
ref table 'E India Partner Balance'
ref table 'Dim Country'
ref table 'Dim Year'
ref table 'Dim Sector'
ref table 'Dim Partner'

ref cultureInfo en-GB

