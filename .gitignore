.DS_Store

# Secrets / environment
.env
.env.*

# Python
__pycache__/
*.pyc

# Editors
.vscode/
.idea/

# Power BI Desktop local cache — regenerated on open
**/.pbi/localSettings.json
**/.pbi/cache.abf

# Compiled Power BI file — shipped as a GitHub Release asset, never committed
*.pbix

# PDF export of the dashboard — kept locally as the screenshot source, never published.
dashboard/*.pdf

# Raw UN Comtrade extracts — not redistributed (see data/raw/README.md).
data/raw/*.csv
